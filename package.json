{
  "name": "ozelhaber",
  "version": "0.2.1",
  "author": "Murat Serdar ERMAN",
  "description": "Gerçek zamanlı interaktif haber haritası ve Windows haber masaüstü uygulaması",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gh-pages": "node -e \"const fs=require('fs'); try { if(fs.existsSync('app/api')) fs.renameSync('app/api', '_api_backup'); const { execSync } = require('child_process'); execSync('next build', { stdio: 'inherit', env: { ...process.env, BUILD_TARGET: 'gh-pages' } }); } finally { if(fs.existsSync('_api_backup')) fs.renameSync('_api_backup', 'app/api'); }\"",
    "start": "next start",
    "desktop": "electron .",
    "desktop:screensaver": "electron . -- --screensaver",
    "package:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "build": {
    "appId": "com.ozelhaber.desktop",
    "productName": "ÖzelHaber",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "assets/**/*",
      "!node_modules/**"
    ],
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "win": {
      "icon": "electron/assets/app.ico",
      "target": ["nsis"],
      "artifactName": "OzelHaber-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
